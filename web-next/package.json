{
  "name": "web-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node ../web/scripts/openapi-fingerprint.mjs --check",
    "api:client": "orval --config orval.config.ts",
    "api:prepare": "npm run api:check && npm run api:client",
    "prepare": "npm run api:prepare",
    "predev": "npm run api:prepare",
    "dev": "vite",
    "prebuild": "npm run api:prepare",
    "build": "vue-tsc -b && vite build",
    "lint": "oxlint --deny-warnings src test orval.config.ts",
    "fmt": "oxfmt src test orval.config.ts",
    "fmt:check": "oxfmt --check src test orval.config.ts",
    "pretest": "npm run api:prepare",
    "test": "vitest run",
    "pretypecheck": "npm run api:prepare",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "hls.js": "^1.7.0",
    "jassub": "^2.5.14",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "orval": "8.24.0",
    "oxfmt": "0.62.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
