Subject: [PATCH] applemedia: separate quality and bitrate control in vtenc

Unconditionally setting VT Quality overrides AverageBitRate on Apple
hardware: changing the requested bitrate can leave encoded output unchanged.
CBR can conceal this by adding filler instead of improving picture quality.

Use Quality when bitrate and data-rate-limits are disabled, otherwise let
bitrate control own quantization. Preserve the existing quality property.
Recreate the session when changing control modes, removing a rate limit,
or changing quality: accepted live Quality updates can have no effect.
Drain valid pending frames rather than using error recovery's discard flag.
Drain the output queue before publishing the new session's codec headers.
Keep same-mode bitrate updates on the existing reconfiguration path.

Also pass the rate-limit window to CoreFoundation with its actual double
width; reading the first float-sized part produces an invalid window.

Tested with generated H.264 and HEVC encodes on Apple Silicon: bitrate
changes, quality changes, ABR/CBR transitions, adding/removing limits, and
full decoding across session recreation without frame loss. See companion
reproducer and measurements.

diff --git a/subprojects/gst-plugins-bad/sys/applemedia/vtenc.c b/subprojects/gst-plugins-bad/sys/applemedia/vtenc.c
--- a/subprojects/gst-plugins-bad/sys/applemedia/vtenc.c
+++ b/subprojects/gst-plugins-bad/sys/applemedia/vtenc.c
@@ -433,7 +433,8 @@
 
   g_object_class_install_property (gobject_class, PROP_BITRATE,
       g_param_spec_uint ("bitrate", "Bitrate",
-          "Target video bitrate in kbps (0 = auto)",
+          "Target video bitrate in kbps (0 = auto; quality controls encoding "
+          "when data-rate-limits is also disabled)",
           0, G_MAXUINT, VTENC_DEFAULT_BITRATE,
           G_PARAM_READWRITE | G_PARAM_CONSTRUCT | G_PARAM_STATIC_STRINGS));
 
@@ -451,7 +452,7 @@
 
   g_object_class_install_property (gobject_class, PROP_QUALITY,
       g_param_spec_double ("quality", "Quality",
-          "The desired compression quality",
+          "Compression quality when bitrate is 0 and data-rate-limits is disabled",
           0.0, 1.0, VTENC_DEFAULT_QUALITY,
           G_PARAM_READWRITE | G_PARAM_CONSTRUCT | G_PARAM_STATIC_STRINGS));
 
@@ -659,6 +660,27 @@
   }
 }
 
+/* Quality and bitrate are distinct controls, not a quality floor plus a
+ * bitrate ceiling. On Apple hardware, setting Quality fixes quantization and
+ * defeats AverageBitRate (and CBR may merely add filler). Preserve the quality
+ * property for automatic-rate encoding, but never set it alongside a rate.
+ * https://developer.apple.com/documentation/videotoolbox/kvtcompressionpropertykey_constantqualityfactor
+ * describes Quality as causing the quantization parameter to "adhere to a
+ * fixed value".
+ */
+static gboolean
+gst_vtenc_has_rate_limit (GstVTEnc * self)
+{
+  return self->max_bitrate > 0 && self->bitrate_window > 0;
+}
+
+static gboolean
+gst_vtenc_uses_quality (GstVTEnc * self)
+{
+  return self->details->format_id != GST_kCMVideoCodecType_Some_AppleProRes
+      && self->bitrate == 0 && !gst_vtenc_has_rate_limit (self);
+}
+
 static void
 gst_vtenc_flag_reconfigure (GstVTEnc * self)
 {
@@ -671,8 +693,15 @@
     GParamSpec * pspec)
 {
   GstVTEnc *self = GST_VTENC_CAST (obj);
+  gboolean was_quality, had_rate_limit;
+  GstVtencRateControl old_rate_control;
+  gdouble old_quality;
 
   GST_OBJECT_LOCK (self);
+  was_quality = gst_vtenc_uses_quality (self);
+  had_rate_limit = gst_vtenc_has_rate_limit (self);
+  old_rate_control = self->rate_control;
+  old_quality = self->quality;
 
   switch (prop_id) {
     case PROP_BITRATE:
@@ -729,6 +758,20 @@
       break;
   }
 
+  /* A new session clears the old, mutually exclusive VT properties. Merely
+   * omitting Quality or DataRateLimits from a reconfigure leaves it active.
+   * ABR <-> CBR must likewise not accumulate both bitrate properties.
+   * Quality changes also need a fresh session: hardware may accept a live
+   * Quality update without changing quantization. Same-mode bitrate changes
+   * retain the lightweight reconfigure.
+   */
+  if (self->session != NULL &&
+      (was_quality != gst_vtenc_uses_quality (self) ||
+          old_rate_control != self->rate_control ||
+          (gst_vtenc_uses_quality (self) && old_quality != self->quality) ||
+          (had_rate_limit && !gst_vtenc_has_rate_limit (self))))
+    g_atomic_int_set (&self->require_rate_control_restart, TRUE);
+
   GST_OBJECT_UNLOCK (self);
 }
 
@@ -860,6 +903,7 @@
   self->is_draining = FALSE;
   self->downstream_ret = GST_FLOW_OK;
   g_atomic_int_set (&self->require_restart, FALSE);
+  g_atomic_int_set (&self->require_rate_control_restart, FALSE);
   g_atomic_int_set (&self->require_reconfigure, FALSE);
 
   self->output_queue = gst_vec_deque_new (VTENC_OUTPUT_QUEUE_SIZE);
@@ -1121,6 +1165,7 @@
   GST_OBJECT_UNLOCK (self);
 
   g_atomic_int_set (&self->require_restart, FALSE);
+  g_atomic_int_set (&self->require_rate_control_restart, FALSE);
   g_atomic_int_set (&self->require_reconfigure, FALSE);
 
   return session != NULL;
@@ -1611,7 +1656,7 @@
   gst_vtenc_session_configure_realtime (self, session, self->realtime);
   gst_vtenc_session_configure_allow_frame_reordering (self, session,
       self->allow_frame_reordering);
-  if (codec_details->format_id != GST_kCMVideoCodecType_Some_AppleProRes)
+  if (gst_vtenc_uses_quality (self))
     gst_vtenc_session_configure_property_double (self, session,
         kVTCompressionPropertyKey_Quality, self->quality);
 
@@ -1759,6 +1804,9 @@
   guint max_bitrate = self->max_bitrate;
   guint bitrate = self->bitrate;
   CFStringRef key = kVTCompressionPropertyKey_AverageBitRate;
+
+  if (gst_vtenc_uses_quality (self))
+    return;
 
   if (self->rate_control == GST_VTENC_RATE_CONTROL_CBR) {
 #ifdef __aarch64__
@@ -1794,7 +1842,7 @@
       int size = (max_bitrate * bitrate_window) / 8;
 
       CFNumberRef cf_size = CFNumberCreate (NULL, kCFNumberIntType, &size);
-      CFNumberRef cf_window = CFNumberCreate (NULL, kCFNumberFloatType,
+      CFNumberRef cf_window = CFNumberCreate (NULL, kCFNumberDoubleType,
           &bitrate_window);
 
       CFTypeRef values[2] = { cf_size, cf_window };
@@ -1960,33 +2008,36 @@
   return status == noErr;
 }
 
-static void
+static GstFlowReturn
 gst_vtenc_restart_session (GstVTEnc * self)
 {
   VTCompressionSessionRef session;
-
-  /* We need to push out all frames still inside the encoder,
-   * otherwise destroy_session() will wait for all callbacks to fire
-   * and very likely deadlock due to the object lock being taken */
-  if (gst_vtenc_push_all_pending_frames (self)) {
-    GST_DEBUG_OBJECT (self, "All frames out, restarting encoder session");
-  } else {
-    GST_DEBUG_OBJECT (self, "Failed to push all pending frames, restarting "
-        "encoder session anyway");
-  }
+  GstFlowReturn ret;
+
+  /* Drain both VT and our output queue before replacing codec_data. Pending
+   * frames still use the old session's parameter sets. A control-mode change
+   * must not set require_restart: that flag discards frames during recovery.
+   */
+  ret = gst_vtenc_drain_encoder (self, FALSE);
+  if (ret != GST_FLOW_OK)
+    return ret;
 
   GST_OBJECT_LOCK (self);
   gst_vtenc_destroy_session (self, &self->session);
-  GST_OBJECT_UNLOCK (self);
-
+  /* Keep setters out until the new session and its flags agree. */
   session = gst_vtenc_create_session (self);
-
-  GST_OBJECT_LOCK (self);
   self->session = session;
-  GST_OBJECT_UNLOCK (self);
 
   g_atomic_int_set (&self->require_reconfigure, FALSE);
   g_atomic_int_set (&self->require_restart, FALSE);
+  g_atomic_int_set (&self->require_rate_control_restart, FALSE);
+  GST_OBJECT_UNLOCK (self);
+  if (session == NULL)
+    return GST_FLOW_ERROR;
+
+  /* A new session may choose different SPS/PPS even with unchanged raw caps. */
+  self->negotiate_downstream = TRUE;
+  return gst_vtenc_ensure_output_loop (self) ? GST_FLOW_OK : GST_FLOW_ERROR;
 }
 
 static void
@@ -2005,8 +2056,9 @@
   gst_vtenc_session_configure_allow_frame_reordering (self, self->session,
       self->allow_frame_reordering);
   gst_vtenc_session_configure_realtime (self, self->session, self->realtime);
-  gst_vtenc_session_configure_property_double (self, self->session,
-      kVTCompressionPropertyKey_Quality, self->quality);
+  if (gst_vtenc_uses_quality (self))
+    gst_vtenc_session_configure_property_double (self, self->session,
+        kVTCompressionPropertyKey_Quality, self->quality);
   gst_vtenc_session_configure_max_keyframe_interval (self, self->session,
       self->max_keyframe_interval);
   gst_vtenc_session_configure_max_keyframe_interval_duration (self,
@@ -2071,9 +2123,12 @@
 
   /* Flushes all remaining frames out of the encoder
    * and recreates the encoding session. */
-  if (g_atomic_int_get (&self->require_restart))
-    gst_vtenc_restart_session (self);
-  else if (g_atomic_int_get (&self->require_reconfigure))
+  if (g_atomic_int_get (&self->require_restart) ||
+      g_atomic_int_get (&self->require_rate_control_restart)) {
+    ret = gst_vtenc_restart_session (self);
+    if (ret != GST_FLOW_OK)
+      goto drop;
+  } else if (g_atomic_int_get (&self->require_reconfigure))
     gst_vtenc_reconfigure_session (self);
 
   if (GST_VIDEO_CODEC_FRAME_IS_FORCE_KEYFRAME (frame)) {
diff --git a/subprojects/gst-plugins-bad/sys/applemedia/vtenc.h b/subprojects/gst-plugins-bad/sys/applemedia/vtenc.h
--- a/subprojects/gst-plugins-bad/sys/applemedia/vtenc.h
+++ b/subprojects/gst-plugins-bad/sys/applemedia/vtenc.h
@@ -123,6 +123,8 @@
   /* If we get an EncoderMalfunctionErr or similar, we restart the session
    * before the next encode call */
   gboolean require_restart;
+  /* A control-mode change drains valid frames; error recovery discards them. */
+  gboolean require_rate_control_restart;
 
   /* Certain properties (e.g. bitrate) can be changed on the fly.
    * We can't do it straight from the setter as that would often deadlock,
