+/* How far a stream may fall behind before it is worth a seek to fetch it,
+ * and how far away its data must be for the seek to pay for itself.
+ *
+ * The lag is deliberately larger than any sane interleave (mp4mux
+ * defaults to 250 ms), so a well-muxed file never reaches it. The
+ * distance mirrors the guard on the header-hunting seek below: a jump
+ * shorter than this costs more in flushes than it saves in reads. */
+#define QTDEMUX_PUSH_SEEK_LAG (2 * GST_SECOND)
+#define QTDEMUX_PUSH_SEEK_DISTANCE (4 * 1024 * 1024)
+
+/*
+ * qtdemux_push_starved_stream
+ *
+ * Pushed, samples are served in byte order, which is right for a file
+ * whose streams are interleaved and wrong for one whose streams are
+ * not: an MP4 written as all video then all audio delivers nothing from
+ * its second stream until the first is exhausted. Anything downstream
+ * that muxes waits that whole time, which on a 1.8 GB file is the
+ * difference between starting and appearing to hang.
+ *
+ * Pulled this never arises, because each stream is read where it lives.
+ * When upstream can seek, pushed can do the same: notice the stream
+ * that has fallen behind in decode time, and say where its data is.
+ *
+ * Returns TRUE and sets @offset when such a stream exists.
+ */
+static gboolean
+qtdemux_push_starved_stream (GstQTDemux * demux, guint64 * offset)
+{
+  GstClockTime lag_time = GST_CLOCK_TIME_NONE, lead_time = 0;
+  guint64 lag_offset = 0;
+  gint i;
+
+  for (i = 0; i < QTDEMUX_N_STREAMS (demux); i++) {
+    QtDemuxStream *stream = QTDEMUX_NTH_STREAM (demux, i);
+    QtDemuxSample *sample;
+    GstClockTime dts;
+
+    /* Nothing left to serve, or nothing served yet: sample_index is
+     * unsigned and "not started" is -1, which this catches too. */
+    if (stream->sample_index >= stream->n_samples)
+      continue;
+    if (!qtdemux_parse_samples (demux, stream, stream->sample_index))
+      continue;
+
+    sample = &stream->samples[stream->sample_index];
+    dts = QTSAMPLE_DTS (stream, sample);
+    if (!GST_CLOCK_TIME_IS_VALID (dts))
+      continue;
+
+    if (dts > lead_time)
+      lead_time = dts;
+    if (!GST_CLOCK_TIME_IS_VALID (lag_time) || dts < lag_time) {
+      lag_time = dts;
+      lag_offset = sample->offset;
+    }
+  }
+
+  if (!GST_CLOCK_TIME_IS_VALID (lag_time)
+      || lead_time - lag_time < QTDEMUX_PUSH_SEEK_LAG)
+    return FALSE;
+
+  /* Behind us it can only be reached by seeking; ahead of us it arrives
+   * on its own, unless it is a long way off. */
+  if (lag_offset >= demux->offset
+      && lag_offset - demux->offset < QTDEMUX_PUSH_SEEK_DISTANCE)
+    return FALSE;
+
+  GST_DEBUG_OBJECT (demux,
+      "stream lags by %" GST_TIME_FORMAT ", its data is at %" G_GUINT64_FORMAT
+      " (%s read position %" G_GUINT64_FORMAT "); seeking to it",
+      GST_TIME_ARGS (lead_time - lag_time), lag_offset,
+      lag_offset < demux->offset ? "behind" : "ahead of", demux->offset);
+
+  *offset = lag_offset;
+  return TRUE;
+}
