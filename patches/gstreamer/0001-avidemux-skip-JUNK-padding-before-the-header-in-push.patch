From 20ad5a38a056aebfaee56faac319ce4f12180bd6 Mon Sep 17 00:00:00 2001
From: Ingmar Steen <iksteen@gmail.com>
Date: Tue, 4 Aug 2026 13:25:29 +0200
Subject: [PATCH 1/3] avidemux: skip JUNK padding before the header in push
 mode

gst_riff_read_chunk() skips JUNK and JUNQ chunks automatically, so an
AVI that pads before the 'hdrl' LIST demuxes normally while avidemux is
pulling. Push mode parses the headers off the adapter instead, through
gst_avi_demux_peek_chunk(), which has no such skip and additionally
refuses a zero-sized chunk by setting abort_buffering. A file whose
first chunk is an empty JUNK therefore fails with

  gstavidemux.c(5932): gst_avi_demux_chain (): unhandled buffer size

before any media is parsed, and only when the source pushes:

  filesrc location=junk0.avi ! queue ! avidemux ! fakesink   -> error
  filesrc location=junk0.avi !         avidemux ! fakesink   -> plays

Zero-sized JUNK chunks inside the movi list are already tolerated
explicitly ("accept 0 size buffer here", bb2b02c5b7), so extend the
same tolerance to padding that precedes the header. Chunks of 1 GiB or
more are left for gst_avi_demux_peek_chunk() to reject as before,
rather than waiting for the adapter to hold one.

Such a file can be built by muxing with avimux and splicing "JUNK" plus
a zero size field in after the 'AVI ' form type, adding 8 to the RIFF
size field; idx1 offsets are relative to the movi list and stay valid.
Four files in a 1872-file AVI collection start this way.
---
 .../gst-plugins-good/gst/avi/gstavidemux.c    | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/subprojects/gst-plugins-good/gst/avi/gstavidemux.c b/subprojects/gst-plugins-good/gst/avi/gstavidemux.c
index 96788aa6..d64980b5 100644
--- a/subprojects/gst-plugins-good/gst/avi/gstavidemux.c
+++ b/subprojects/gst-plugins-good/gst/avi/gstavidemux.c
@@ -3352,6 +3352,26 @@ gst_avi_demux_stream_header_push (GstAviDemux * avi)
   switch (avi->header_state) {
     case GST_AVI_DEMUX_HEADER_TAG_LIST:
     again:
+      /* Skip JUNK padding ahead of the header, as gst_riff_read_chunk()
+       * does for pull mode. This must not go through
+       * gst_avi_demux_peek_chunk(): that rejects a zero-sized chunk and
+       * asks the chain to give up, so a file starting with an empty JUNK
+       * chunk errors out here while playing fine when pulled.
+       * An absurdly large chunk is left to gst_avi_demux_peek_chunk()
+       * to reject, as before, rather than buffered up in the adapter. */
+      while (gst_avi_demux_peek_chunk_info (avi, &tag, &size) &&
+          (tag == GST_RIFF_TAG_JUNK || tag == GST_RIFF_TAG_JUNQ) &&
+          size < (1 << 30)) {
+        guint flush = 8 + GST_ROUND_UP_2 (size);
+
+        if (gst_adapter_available (avi->adapter) < flush)
+          return GST_FLOW_OK;   /* wait for the whole chunk */
+
+        GST_DEBUG_OBJECT (avi, "skipping JUNK chunk of %u bytes", size);
+        gst_adapter_flush (avi->adapter, flush);
+        avi->offset += flush;
+      }
+
       if (gst_avi_demux_peek_chunk (avi, &tag, &size)) {
         avi->offset += 8 + GST_ROUND_UP_2 (size);
         if (tag != GST_RIFF_TAG_LIST)
