From 1a1d4cd93a0b3518c783ebb9b5fffed1d05f6112 Mon Sep 17 00:00:00 2001
From: Ingmar Steen <iksteen@gmail.com>
Date: Thu, 6 Aug 2026 11:44:15 +0200
Subject: [PATCH] matroskademux: do not advance the read offset when the skip
 did not happen
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

gst_matroska_demux_flush() moved demux->common.offset before it knew
whether the bytes could be dropped. When the element to skip is larger
than the adapter currently holds, the function returns GST_FLOW_EOS so
the caller waits for more data — and reads the same element again, with
the offset already advanced past it.

Every offset after a Void bigger than the adapter is then wrong by that
Void's size. Observed on a file with a 1261-byte Void before the first
Cluster: the Void is parsed twice, and the demuxer places the Cluster at
5728 when it is at 4458. Nothing complains, because in streaming mode
the offset is mostly used for bookkeeping — until something seeks by it,
at which point the seek lands inside a Cluster and the parse resyncs
through the rest of the file.

Advance only once the adapter has actually given up the bytes. Pull mode
is unaffected: it does not enter that branch.
---
 .../gst-plugins-good/gst/matroska/matroska-demux.c     | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/subprojects/gst-plugins-good/gst/matroska/matroska-demux.c b/subprojects/gst-plugins-good/gst/matroska/matroska-demux.c
index 14188913f54..65d8e25468a 100644
--- a/subprojects/gst-plugins-good/gst/matroska/matroska-demux.c
+++ b/subprojects/gst-plugins-good/gst/matroska/matroska-demux.c
@@ -6149,7 +6149,6 @@ static inline GstFlowReturn
 gst_matroska_demux_flush (GstMatroskaDemux * demux, guint flush)
 {
   GST_LOG_OBJECT (demux, "skipping %d bytes", flush);
-  demux->common.offset += flush;
   if (demux->streaming) {
     GstFlowReturn ret;
 
@@ -6157,11 +6156,14 @@ gst_matroska_demux_flush (GstMatroskaDemux * demux, guint flush)
     ret = gst_matroska_demux_check_read_size (demux, flush);
     if (ret != GST_FLOW_OK)
       return ret;
-    if (flush <= gst_adapter_available (demux->common.adapter))
-      gst_adapter_flush (demux->common.adapter, flush);
-    else
+    /* Not enough data yet: the caller will be back with more and will
+     * read this same element again, so the offset must not move until
+     * the bytes are actually gone. */
+    if (flush > gst_adapter_available (demux->common.adapter))
       return GST_FLOW_EOS;
+    gst_adapter_flush (demux->common.adapter, flush);
   }
+  demux->common.offset += flush;
   return GST_FLOW_OK;
 }
 
-- 
2.55.0

