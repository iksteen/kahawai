{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src test",
    "fmt": "oxfmt src test",
    "fmt:check": "oxfmt --check src test",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "jassub": "^2.5.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "0.62.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
