{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/openapi-fingerprint.mjs --check",
    "api:client": "orval --config orval.config.ts",
    "api:export": "rm -f openapi.json.tmp && KAHAWAI_SKIP_WEB_BUILD=1 cargo run --quiet -p kahawai-hub --example export_openapi -- openapi.json.tmp && node scripts/openapi-fingerprint.mjs --write openapi.json.tmp && KAHAWAI_OPENAPI=./openapi.json.tmp npm run api:client && mv openapi.json.tmp openapi.json",
    "api:prepare": "npm run api:check && npm run api:client",
    "prepare": "npm run api:prepare",
    "predev": "npm run api:prepare",
    "dev": "vite",
    "prebuild": "npm run api:prepare",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src test scripts orval.config.ts",
    "fmt": "oxfmt src test scripts orval.config.ts",
    "fmt:check": "oxfmt --check src test scripts orval.config.ts",
    "pretest": "npm run api:prepare",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview",
    "pretypecheck": "npm run api:prepare",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "jassub": "^2.5.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "orval": "8.24.0",
    "oxfmt": "0.62.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
